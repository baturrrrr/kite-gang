generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  password   String
  role       String      @default("RECEPTION")
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  auditLogs  AuditLog[]
  instructor Instructor?

  @@index([email])
}

model Instructor {
  id                 String              @id @default(cuid())
  userId             String              @unique
  phone              String?
  paymentModel       String              @default("HOURLY_RATE")
  hourlyRate         Float?
  hourlyRateCurrency String              @default("TRY")
  revenueShare       Float?
  monthlySalary      Float?
  salaryCurrency     String              @default("TRY")
  color              String              @default("#3B82F6")
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  hizmetler          Hizmet[]
  user               User                @relation(fields: [userId], references: [id])
  earnings           InstructorEarning[]
  payouts            InstructorPayout[]
  lessons            Lesson[]
  reservations       Reservation[]

  @@index([userId])
}

model Student {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  phone            String?
  nationality      String?
  language         String?
  emergencyContact String?
  emergencyPhone   String?
  skillLevel       String            @default("BEGINNER")
  notes            String?
  waiverSigned     Boolean           @default(false)
  waiverSignedAt   DateTime?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  birthDate        DateTime?
  gender           String?
  weight           Float?
  hizmetler        Hizmet[]
  lessons          Lesson[]
  packagePurchases PackagePurchase[]
  payments         Payment[]
  reservations     Reservation[]

  @@index([lastName, firstName])
  @@index([email])
}

model LessonPackage {
  id           String            @id @default(cuid())
  name         String
  description  String?
  lessonType   String
  totalHours   Float
  price        Float
  currency     String            @default("TRY")
  validityDays Int?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  purchases    PackagePurchase[]

  @@index([isActive])
}

model PackagePurchase {
  id             String        @id @default(cuid())
  studentId      String
  packageId      String
  totalHours     Float
  remainingHours Float
  purchasePrice  Float
  currency       String        @default("TRY")
  purchasedAt    DateTime      @default(now())
  expiresAt      DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lessons        Lesson[]
  package        LessonPackage @relation(fields: [packageId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id])
  payments       Payment[]

  @@index([studentId])
  @@index([packageId])
}

model Reservation {
  id             String      @id @default(cuid())
  studentId      String
  instructorId   String?
  lessonType     String
  equipmentId    String?
  rentalAmount   Float?
  rentalCurrency String?
  startTime      DateTime
  endTime        DateTime
  plannedHours   Float
  status         String      @default("PLANNED")
  notes          String?
  cancelReason   String?
  createdById    String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  lesson         Lesson?
  equipment      Equipment?  @relation(fields: [equipmentId], references: [id])
  instructor     Instructor? @relation(fields: [instructorId], references: [id])
  student        Student     @relation(fields: [studentId], references: [id])

  @@index([instructorId, startTime])
  @@index([studentId])
  @@index([startTime])
  @@index([status])
  @@index([equipmentId])
}

model Lesson {
  id                String             @id @default(cuid())
  reservationId     String             @unique
  studentId         String
  instructorId      String?
  purchaseId        String?
  actualHours       Float?
  checkInTime       DateTime
  checkOutTime      DateTime?
  kiteSize          String?
  boardType         String?
  harness           Boolean            @default(false)
  wetsuit           Boolean            @default(false)
  equipmentNotes    String?
  instructorNotes   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  instructorEarning InstructorEarning?
  purchase          PackagePurchase?   @relation(fields: [purchaseId], references: [id])
  instructor        Instructor?        @relation(fields: [instructorId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])
  reservation       Reservation        @relation(fields: [reservationId], references: [id])

  @@index([instructorId])
  @@index([studentId])
  @@index([checkInTime])
}

model Payment {
  id                String             @id @default(cuid())
  studentId         String?
  purchaseId        String?
  hizmetId          String?
  amount            Float
  kasaAmount        Float?
  currency          String             @default("TRY")
  method            String
  direction         String             @default("INCOMING")
  description       String?
  recordedById      String?
  recordedAt        DateTime           @default(now())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cashRegisterEntry CashRegisterEntry?
  hizmet            Hizmet?            @relation(fields: [hizmetId], references: [id])
  purchase          PackagePurchase?   @relation(fields: [purchaseId], references: [id])
  student           Student?           @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([recordedAt])
  @@index([hizmetId])
}

model Expense {
  id                String             @id @default(cuid())
  category          String
  amount            Float
  currency          String             @default("TRY")
  method            String
  description       String
  receiptUrl        String?
  expenseDate       DateTime
  recordedById      String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cashRegisterEntry CashRegisterEntry?

  @@index([expenseDate])
  @@index([category])
}

model InstructorEarning {
  id           String     @id @default(cuid())
  instructorId String
  lessonId     String     @unique
  amount       Float
  currency     String     @default("TRY")
  hours        Float
  isPaid       Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lesson       Lesson     @relation(fields: [lessonId], references: [id])
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  @@index([instructorId])
  @@index([isPaid])
}

model InstructorPayout {
  id                String             @id @default(cuid())
  instructorId      String
  amount            Float
  currency          String             @default("TRY")
  method            String
  periodStart       DateTime?
  periodEnd         DateTime?
  notes             String?
  paidAt            DateTime           @default(now())
  recordedById      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cashRegisterEntry CashRegisterEntry?
  instructor        Instructor         @relation(fields: [instructorId], references: [id])

  @@index([instructorId])
}

model CashAccount {
  id          String              @id @default(cuid())
  name        String
  accountType String              @default("CASH")
  currency    String              @default("TRY")
  balance     Float               @default(0)
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  entries     CashRegisterEntry[]

  @@index([accountType, currency])
}

model CashRegisterEntry {
  id           String            @id @default(cuid())
  accountId    String
  entryType    String
  amount       Float
  currency     String            @default("TRY")
  description  String
  paymentId    String?           @unique
  expenseId    String?           @unique
  payoutId     String?           @unique
  recordedById String?
  recordedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  payout       InstructorPayout? @relation(fields: [payoutId], references: [id])
  expense      Expense?          @relation(fields: [expenseId], references: [id])
  payment      Payment?          @relation(fields: [paymentId], references: [id])
  account      CashAccount       @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([recordedAt])
}

model Equipment {
  id           String        @id @default(cuid())
  type         String
  name         String
  size         String?
  brand        String?
  quantity     Int           @default(1)
  status       String        @default("AVAILABLE")
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hizmetler    Hizmet[]
  reservations Reservation[]

  @@index([type, status])
}

model HizmetSablonu {
  id               String        @id @default(cuid())
  category         String
  name             String
  subCategory      String?
  requiredPeople   Int?
  description      String?
  onlineVisibility String        @default("LISTED")
  validityDays     Int?
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  fiyatlar         HizmetFiyat[]

  @@index([category])
}

model HizmetFiyat {
  id          String        @id @default(cuid())
  sablonId    String
  zamanBirimi String
  currency    String
  price       Float
  createdAt   DateTime      @default(now())
  sablon      HizmetSablonu @relation(fields: [sablonId], references: [id], onDelete: Cascade)

  @@index([sablonId])
}

model Hizmet {
  id                String      @id @default(cuid())
  category          String
  sablonId          String?
  studentId         String?
  instructorId      String?
  equipmentId       String?
  title             String
  description       String?
  amount            Float       @default(0)
  currency          String      @default("TRY")
  quantity          Int?
  durationHours     Float?      // Hizmet süresi (saat) — saatlik fiyat hesabı için
  paymentMethod     String?
  instructorEarning Float?
  status            String      @default("BEKLIYOR")
  scheduledAt       DateTime?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  notes             String?
  createdById       String?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  equipment         Equipment?  @relation(fields: [equipmentId], references: [id])
  instructor        Instructor? @relation(fields: [instructorId], references: [id])
  student           Student?    @relation(fields: [studentId], references: [id])
  payments          Payment[]

  @@index([category])
  @@index([studentId])
  @@index([instructorId])
  @@index([equipmentId])
  @@index([status])
  @@index([scheduledAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
